generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RoleType {
  BUYER
  SELLER
  RENTAL
  SERVICE
  EDUCATOR
  DRIVER
  LABOR
  WAREHOUSE
  EXPERT
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  RESUBMIT
}

enum ListingType {
  PRODUCT
  EQUIPMENT
  SERVICE
  COURSE
  LAND
  WAREHOUSE
  LABOR
  DRIVER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum OrderKind {
  PRODUCT
  RENTAL
  SERVICE
  COURSE
  LOGISTICS
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PACKED
  SHIPPED
  DELIVERED
  CONFIRMED
  RENTED
  RETURN_INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
}

enum WalletTxnType {
  CREDIT
  DEBIT
  ESCROW_HOLD
  ESCROW_RELEASE
  PAYOUT
  REFUND
  FEE
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  ESCALATED
  RESOLVED
  CLOSED
}

enum AuditAction {
  LOGIN
  LOGOUT
  ROLE_SWITCH
  KYC_SUBMIT
  KYC_DECISION
  LISTING_PUBLISH
  ORDER_STATUS
  PAYOUT_REQUEST
  PAYOUT_APPROVE
  REFUND
  USER_SUSPEND
  SETTINGS_CHANGE
}

// ─── Core identity ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  location      String?
  locale        String    @default("en")
  timezone      String    @default("Asia/Kolkata")
  isActive      Boolean   @default(true)
  phoneVerified Boolean   @default(false)
  emailVerified Boolean   @default(false)
  kycStatus     KycStatus @default(NONE)
  activeRole    RoleType?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  roles           UserRole[]
  businesses      Business[]
  sessions        Session[]
  devices         Device[]
  kycDocuments    KycDocument[]
  listings        Listing[]
  ordersAsBuyer   Order[]            @relation("BuyerOrders")
  ordersAsSeller  Order[]            @relation("SellerOrders")
  wallet          Wallet?
  messagesSent    Message[]          @relation("SentMessages")
  conversationMembers ConversationMember[]
  notifications   Notification[]
  reviewsGiven    Review[]           @relation("ReviewsGiven")
  reviewsReceived Review[]           @relation("ReviewsReceived")
  tickets         SupportTicket[]    @relation("TicketRequester")
  ticketNotes     TicketNote[]
  auditLogs       AuditLog[]
  wishlist        WishlistItem[]
  cartItems       CartItem[]

  @@index([kycStatus])
  @@index([deletedAt])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      RoleType
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Business {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String?
  gstin        String?
  address      String?
  experienceYrs Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[]

  @@index([userId])
}

model BankAccount {
  id            String   @id @default(cuid())
  businessId    String
  holderName    String
  bankName      String
  accountNumber String
  ifsc          String
  upiId         String?
  isPrimary     Boolean  @default(true)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model KycDocument {
  id         String    @id @default(cuid())
  userId     String
  docType    String
  fileUrl    String
  status     KycStatus @default(PENDING)
  notes      String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  deviceName String?
  platform   String?
  pushToken  String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, consumed])
  @@index([expiresAt])
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Listing {
  id          String        @id @default(cuid())
  ownerId     String
  type        ListingType
  status      ListingStatus @default(DRAFT)
  title       String
  slug        String        @unique
  description String
  category    String
  subcategory String?
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  unit        String?
  moq         Decimal?      @db.Decimal(12, 2)
  quantity    Decimal?      @db.Decimal(12, 2)
  reorderLevel Decimal?     @db.Decimal(12, 2)
  location    String?
  latitude    Float?
  longitude   Float?
  serviceRadiusKm Int?
  images      String[]
  attributes  Json?
  deposit     Decimal?      @db.Decimal(12, 2)
  ratingAvg   Float         @default(0)
  ratingCount Int           @default(0)
  viewCount   Int           @default(0)
  publishedAt DateTime?
  availableTill DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  owner       User                 @relation(fields: [ownerId], references: [id])
  availability ListingAvailability[]
  orderItems  OrderItem[]
  reviews     Review[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  conversations Conversation[]

  @@index([ownerId, status])
  @@index([type, status])
  @@index([category])
  @@index([latitude, longitude])
  @@index([deletedAt])
}

model ListingAvailability {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime
  endDate   DateTime
  status    String   @default("available") // available | blocked | maintenance | booked
  note      String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  quantity  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

// ─── Orders & payments ───────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  kind            OrderKind
  status          OrderStatus   @default(PENDING)
  buyerId         String
  sellerId        String
  subtotal        Decimal       @db.Decimal(12, 2)
  platformFee     Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  deposit         Decimal?      @db.Decimal(12, 2)
  startAt         DateTime?
  endAt           DateTime?
  shippingAddress Json?
  trackingNumber  String?
  logisticsPartner String?
  notes           String?
  cancelReason    String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  buyer         User            @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller        User            @relation("SellerOrders", fields: [sellerId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  payment       Payment?
  conversation  Conversation?
  reviews       Review[]
  tickets       SupportTicket[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([kind, status])
  @@index([createdAt])
  @@index([deletedAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  listingId  String
  title      String
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  attributes Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  providerRef     String?
  failureReason   String?
  authorizedAt    DateTime?
  capturedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  availableBalance Decimal @db.Decimal(14, 2) @default(0)
  escrowBalance  Decimal  @db.Decimal(14, 2) @default(0)
  currency       String   @default("INR")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payouts      PayoutRequest[]
}

model WalletTransaction {
  id          String        @id @default(cuid())
  walletId    String
  type        WalletTxnType
  amount      Decimal       @db.Decimal(14, 2)
  balanceAfter Decimal      @db.Decimal(14, 2)
  reference   String?
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type])
}

model PayoutRequest {
  id          String   @id @default(cuid())
  walletId    String
  amount      Decimal  @db.Decimal(14, 2)
  status      String   @default("pending") // pending | approved | rejected | paid
  bankSnapshot Json?
  reviewedBy  String?
  reviewedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
}

// ─── Messaging & notifications ───────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  orderId   String?  @unique
  listingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order?               @relation(fields: [orderId], references: [id])
  listing   Listing?             @relation(fields: [listingId], references: [id])
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  push       Boolean  @default(true)
  sms        Boolean  @default(true)
  email      Boolean  @default(true)
  inApp      Boolean  @default(true)
  quietStart String?  @default("22:00")
  quietEnd   String?  @default("06:00")
  updatedAt  DateTime @updatedAt
}

// ─── Reviews & support ───────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  orderId    String
  listingId  String?
  authorId   String
  targetId   String
  rating     Int
  text       String
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id])
  author  User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  target  User     @relation("ReviewsReceived", fields: [targetId], references: [id])

  @@unique([orderId, authorId])
  @@index([targetId])
  @@index([listingId])
}

model SupportTicket {
  id          String       @id @default(cuid())
  ticketNumber String      @unique
  requesterId String
  orderId     String?
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  priority    String       @default("medium")
  assigneeId  String?
  slaDueAt    DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User         @relation("TicketRequester", fields: [requesterId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])
  notes     TicketNote[]

  @@index([requesterId, status])
  @@index([status, slaDueAt])
}

model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
